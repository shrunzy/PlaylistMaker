<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="22dp"
    android:paddingRight="16dp"
    android:paddingBottom="32dp"
    android:background="@color/settings_screen_background">

    <LinearLayout style="@style/LinearLayoutSettingsStyle">

        <ImageView
            android:id="@+id/settings_back"
            style="@style/IconSettingsStyle"
            app:tint="@color/settings_text_color"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="arrow"
            android:src="@drawable/ic_back_arrow_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            style="@style/TextTitleStyle"
            android:textColor="@color/settings_text_color"/>
    </LinearLayout>

    <LinearLayout style="@style/LinearLayoutSettingsStyle">

        <TextView
            style="@style/TextSettingsStyle"
            android:text="@string/dark_theme" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:trackTint="@color/switch_track"
            app:thumbTint="@color/switch_thumb"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/share_app_layout"
        style="@style/LinearLayoutSettingsStyle">


        <TextView
            style="@style/TextSettingsStyle"
            android:text="@string/share" />

        <ImageView
            style="@style/IconSettingsStyle"
            android:contentDescription="share"
            android:src="@drawable/share" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/email_support_layout"
        style="@style/LinearLayoutSettingsStyle">


        <TextView
            style="@style/TextSettingsStyle"
            android:text="@string/support" />

        <ImageView
            style="@style/IconSettingsStyle"
            android:contentDescription="support"
            android:src="@drawable/support" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/user_agreement_layout"
        style="@style/LinearLayoutSettingsStyle">

        <TextView
            style="@style/TextSettingsStyle"
            android:text="@string/agreement" />

        <ImageView
            style="@style/IconSettingsStyle"
            android:contentDescription="forward arrow"
            android:src="@drawable/ic_forward_arrow_24" />

    </LinearLayout>

</LinearLayout>
