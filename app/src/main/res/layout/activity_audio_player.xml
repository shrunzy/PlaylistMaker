<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/leftControlGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.066667" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/rightControlGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.933333" />

        <ImageView
            android:id="@+id/playerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back_arrow_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/player_primary" />

        <ImageView
            android:id="@+id/coverArtwork"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/track_cover"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@id/rightControlGuideline"
            app:layout_constraintStart_toStartOf="@id/leftControlGuideline"
            app:layout_constraintTop_toBottomOf="@id/playerBack" />

        <TextView
            android:id="@+id/trackName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:fontFamily="@font/ys_display_regular"
            android:maxLines="2"
            android:textColor="@color/player_primary"
            android:textSize="22sp"
            android:textFontWeight="400"
            app:layout_constraintEnd_toEndOf="@id/rightControlGuideline"
            app:layout_constraintStart_toStartOf="@id/leftControlGuideline"
            app:layout_constraintTop_toBottomOf="@id/coverArtwork" />

        <TextView
            android:id="@+id/artistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/ys_display_regular"
            android:maxLines="2"
            android:textColor="@color/player_primary"
            android:textSize="14sp"
            android:textFontWeight="400"
            app:layout_constraintEnd_toEndOf="@id/rightControlGuideline"
            app:layout_constraintStart_toStartOf="@id/leftControlGuideline"
            app:layout_constraintTop_toBottomOf="@id/trackName" />

        <View
            android:id="@+id/playbackControlArea"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/artistName" />

        <ImageButton
            android:id="@+id/addToPlaylistButton"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/add_to_playlist"
            android:padding="0dp"
            android:src="@drawable/button_check_box_player"
            app:layout_constraintBottom_toBottomOf="@id/playButton"
            app:layout_constraintStart_toStartOf="@id/leftControlGuideline"
            app:layout_constraintTop_toTopOf="@id/playButton" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/play"
            android:padding="0dp"
            android:src="@drawable/button_play"
            app:layout_constraintBottom_toBottomOf="@id/playbackControlArea"
            app:layout_constraintEnd_toEndOf="@id/playbackControlArea"
            app:layout_constraintStart_toStartOf="@id/playbackControlArea"
            app:layout_constraintTop_toTopOf="@id/playbackControlArea"
            app:tint="@color/player_primary" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/add_to_favorites"
            android:padding="0dp"
            android:src="@drawable/button_heart_player"
            app:layout_constraintBottom_toBottomOf="@id/playButton"
            app:layout_constraintEnd_toEndOf="@id/rightControlGuideline"
            app:layout_constraintTop_toTopOf="@id/playButton" />

        <TextView
            android:id="@+id/playbackProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_medium"
            android:layout_marginTop="4dp"
            android:text="@string/initial_progress"
            android:textColor="@color/player_primary"
            android:textSize="14sp"
            android:textFontWeight="500"
            app:layout_constraintEnd_toEndOf="@id/playButton"
            app:layout_constraintStart_toStartOf="@id/playButton"
            app:layout_constraintTop_toBottomOf="@id/playbackControlArea" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/metadataGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45" />

        <TextView
            android:id="@+id/durationLabel"
            style="@style/PlayerMetadataLabel"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:text="@string/duration"
            app:layout_constraintEnd_toStartOf="@id/metadataGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playbackProgress" />

        <TextView
            android:id="@+id/durationValue"
            style="@style/PlayerMetadataValue"
            android:layout_width="0dp"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            app:layout_constraintBaseline_toBaselineOf="@id/durationLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/metadataGuideline" />

        <TextView
            android:id="@+id/albumLabel"
            style="@style/PlayerMetadataLabel"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/album"
            app:layout_constraintEnd_toStartOf="@id/metadataGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/durationLabel" />

        <TextView
            android:id="@+id/albumValue"
            style="@style/PlayerMetadataValue"
            android:layout_width="0dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/albumLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/metadataGuideline" />

        <TextView
            android:id="@+id/yearLabel"
            style="@style/PlayerMetadataLabel"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/year"
            app:layout_constraintEnd_toStartOf="@id/metadataGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/albumLabel" />

        <TextView
            android:id="@+id/yearValue"
            style="@style/PlayerMetadataValue"
            android:layout_width="0dp"
            android:layout_marginEnd="16dp"
            android:gravity="end"
            app:layout_constraintBaseline_toBaselineOf="@id/yearLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/metadataGuideline" />

        <TextView
            android:id="@+id/genreLabel"
            style="@style/PlayerMetadataLabel"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/genre"
            app:layout_constraintEnd_toStartOf="@id/metadataGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/yearLabel" />

        <TextView
            android:id="@+id/genreValue"
            style="@style/PlayerMetadataValue"
            android:layout_width="0dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/genreLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/metadataGuideline" />

        <TextView
            android:id="@+id/countryLabel"
            style="@style/PlayerMetadataLabel"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/country"
            app:layout_constraintEnd_toStartOf="@id/metadataGuideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/genreLabel" />

        <TextView
            android:id="@+id/countryValue"
            style="@style/PlayerMetadataValue"
            android:layout_width="0dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/countryLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/metadataGuideline" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/albumGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="albumLabel,albumValue" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/yearGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="yearLabel,yearValue" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
